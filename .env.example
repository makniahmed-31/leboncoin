# Copy to .env.local and fill in. `.env*.local` is git-ignored.
#
#   cp .env.example .env.local

# Where the messaging API lives. Server-side only, and deliberately not NEXT_PUBLIC_.
#
# Only this application's server reaches the API: Server Components call it directly, and the
# browser calls this application's own route handlers, which forward. Keeping the value out of the
# client bundle is what lets the API sit on a private network with no public ingress at all — and
# it is the reason there is no CORS configuration here to get wrong.
API_URL=http://localhost:3005/api

# Must be the same value the API was started with. This application verifies the session cookie's
# signature before rendering a page as anybody, so a mismatch means every visitor looks signed out.
AUTH_SECRET=change-me-to-match-the-api

# 'sse' for the pushed transport, 'polling' for the fallback. Baked into the client bundle at
# build time, so changing it requires a rebuild rather than a restart.
NEXT_PUBLIC_TRANSPORT=sse

# Probability between 0 and 1 that a call to the API fails instead of being made. Off unless set.
# Injected at the API boundary rather than in the route handlers, so it reaches server-rendered
# pages too — which is where a dead backend actually shows up first.
#   CHAOS_RATE=0.3 npm run dev
CHAOS_RATE=0

# Whether the session cookie carries the `Secure` attribute. Defaults to on, and on is what you
# want: a browser discards a `Secure` cookie on a plain-HTTP origin, so set this to false only
# for a deployment reached over http:// with no TLS in front of it — the cookie then travels in
# cleartext. Putting a certificate in front is what lets it go back to the default.
COOKIE_SECURE=true
