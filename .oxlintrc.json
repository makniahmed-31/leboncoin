{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "nextjs", "jsx-a11y", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "es2024": true
  },
  "rules": {
    "eslint/no-console": ["error", { "allow": ["warn", "error"] }],
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "import/no-cycle": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/no-aria-hidden-on-focusable": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "unicorn/no-array-reduce": "off",
    "unicorn/prefer-query-selector": "off",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": [
          "**/*.css",
          "server-only",
          "vitest",
          "@testing-library/jest-dom/vitest",
          "vitest-axe/extend-expect"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**/*.test.{ts,tsx}", "src/test/**", "e2e/**"],
      "rules": {
        "eslint/no-console": "off",
        "typescript/no-explicit-any": "off",
        "eslint/no-await-in-loop": "off"
      }
    },
    {
      "files": ["src/lib/route-handler.ts", "src/app/error.tsx", "scripts/**"],
      "rules": { "eslint/no-console": "off" }
    }
  ],
  "ignorePatterns": [".next", "coverage", "playwright-report", "test-results", "next-env.d.ts"]
}
